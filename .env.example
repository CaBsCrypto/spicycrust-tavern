# SpicyCrust Tavern — Plantilla de Variables de Entorno (Ejemplo)
# Copia este archivo a `.env` o `.env.production` y llena tus valores reales.

# Feature Flag para activar / desactivar Privy (true = activado, false = desactivado para colaboradores/API Leaderboard)
VITE_ENABLE_PRIVY=true

# Credenciales y URLs de Privy + Avalanche C-Chain
VITE_PRIVY_APP_ID=clx_spicycrust_app_id
VITE_HUB_ORIGIN_URL=http://localhost:5173

# URLs de los juegos (Subdominios o Puertos Locales)
VITE_URL_SLASH_SLICE=http://localhost:5174
VITE_URL_SPICY_CHALLENGE=http://localhost:5175
VITE_URL_RHYTHM_SLICE=http://localhost:5176
